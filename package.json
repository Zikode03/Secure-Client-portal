{
  "name": "secure-client-portal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run api:check && tsc -b && vite build",
    "build:check": "npm run api:check && tsc -b && vite build --mode local-check",
    "api:generate": "node tools/generate-api.mjs",
    "api:check": "node tools/generate-api.mjs --check",
    "api:test": "node --test tools/check-api-generation.mjs",
    "api:sync": "node tools/sync-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "^1.17.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.5.438",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
